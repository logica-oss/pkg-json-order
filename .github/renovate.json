{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Release when a production dependency changes",
      "matchDepTypes": ["dependencies", "peerDependencies", "optionalDependencies"],
      "addLabels": ["patch"]
    }
  ]
}
